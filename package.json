{
  "name": "gogreen",
  "version": "2.1.0",
  "description": "Modern, safe CLI and web tool to audit, detect gaps, and design genuine-compliant GitHub contribution graph activity.",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "gogreen": "./bin/gogreen.js"
  },
  "scripts": {
    "start": "node bin/gogreen.js",
    "web": "node bin/gogreen.js web",
    "test": "node --test",
    "check": "node --check bin/gogreen.js src/index.js src/core/*.js src/cli/*.js src/web/*.js tests/*.js"
  },
  "keywords": [
    "github",
    "contribution-graph",
    "activity",
    "pixel-art",
    "automation",
    "git-history",
    "developer-tools"
  ],
  "author": "CodeByArnob (https://github.com/CodeByArnob)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeByArnob/goGreen.git"
  },
  "bugs": {
    "url": "https://github.com/CodeByArnob/goGreen/issues"
  },
  "homepage": "https://github.com/CodeByArnob/goGreen#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "dayjs": "^1.11.23",
    "inquirer": "^14.3.1",
    "simple-git": "^4.1.0"
  }
}
